def format_heated_debate_stage(stage: HeatedDebateStage) -> str:
    project_names = ", ".join(project.name for project in stage.projects)
    return (
        "## Heated Debate Staged\n"
        f"- Topic: `{stage.topic_path}`\n"
        f"- Candidate projects: {project_names}\n"
        f"- Run: `{stage.command}`"
    )


def _heated_debate_root(stage: HeatedDebateStage) -> Path:
    return stage.debate_dir.parent.parent


def _heated_debate_transcript(stage: HeatedDebateStage) -> Path | None:
    candidates = [
        path
        for path in stage.debate_dir.glob("*.md")
        if re.fullmatch(r"\d{8}_\d{6}\.md", path.name)
    ]
    if not candidates:
        return None
    return max(candidates, key=lambda path: path.stat().st_mtime)


def _run_heated_git(heated_root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=heated_root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
        check=False,
    )


def _normalize_debate_artifacts(debate_dir: Path) -> None:
    for path in debate_dir.iterdir():
        if not path.is_file() or path.suffix not in {".log", ".md", ".txt"}:
            continue
        text = path.read_text(encoding="utf-8")
        lines = [line.rstrip(" \t") for line in text.splitlines()]
        while lines and not lines[-1]:
            lines.pop()
        normalized = "\n".join(lines) + ("\n" if lines else "")
        if normalized != text:
            path.write_text(normalized, encoding="utf-8")


def commit_heated_debate_stage(
    stage: HeatedDebateStage,
    run: HeatedDebateRun,
) -> HeatedDebateCommit:
    """Commit one successful debate directory without capturing other repo changes."""
    if not _bool_env("TOOL_DIGEST_COMMIT_HEATED_DEBATE", True):
        return HeatedDebateCommit(None)
    if run.returncode != 0 or run.transcript_path is None:
        return HeatedDebateCommit(None)

    heated_root = _heated_debate_root(stage).resolve()
    debate_dir = stage.debate_dir.resolve()
    try:
        rel_dir = debate_dir.relative_to(heated_root)
    except ValueError:
        return HeatedDebateCommit(None, f"debate directory is outside heated-debate root: {debate_dir}")

    required_paths = (stage.topic_path, stage.context_path, run.transcript_path)
    for path in required_paths:
        resolved = path.resolve()
        if not resolved.is_file():
            return HeatedDebateCommit(None, f"required debate artifact missing: {path}")
        try:
            resolved.relative_to(debate_dir)
        except ValueError:
            return HeatedDebateCommit(None, f"debate artifact is outside staged directory: {path}")

    root_check = _run_heated_git(heated_root, "rev-parse", "--show-toplevel")
    if root_check.returncode != 0:
        return HeatedDebateCommit(None, root_check.stderr.strip() or "heated-debate is not a git repository")
    if Path(root_check.stdout.strip()).resolve() != heated_root:
        return HeatedDebateCommit(None, "heated-debate root does not match the git worktree root")

    rel_path = rel_dir.as_posix()
    outside_status = _run_heated_git(
        heated_root,
        "status",
        "--porcelain=v1",
        "--untracked-files=all",
        "--",
        ".",
        f":(exclude){rel_path}",
    )
    if outside_status.returncode != 0:
        return HeatedDebateCommit(None, outside_status.stderr.strip() or "git status failed")
    if outside_status.stdout.strip():
        return HeatedDebateCommit(
            None,
            f"refusing to auto-commit; heated-debate has changes outside {rel_path}",
        )

    _normalize_debate_artifacts(debate_dir)
    add = _run_heated_git(heated_root, "add", "--", rel_path)
    if add.returncode != 0:
        return HeatedDebateCommit(None, add.stderr.strip() or "git add failed")

    staged = _run_heated_git(heated_root, "diff", "--cached", "--name-only")
    if staged.returncode != 0:
        return HeatedDebateCommit(None, staged.stderr.strip() or "staged-path inspection failed")
    staged_paths = [path for path in staged.stdout.splitlines() if path]
    if not staged_paths:
        return HeatedDebateCommit(None, f"no debate artifacts staged under {rel_path}")
    if any(path != rel_path and not path.startswith(f"{rel_path}/") for path in staged_paths):
        return HeatedDebateCommit(None, "refusing to auto-commit staged paths outside the debate directory")

    diff_check = _run_heated_git(heated_root, "diff", "--cached", "--check", "--", rel_path)
    if diff_check.returncode != 0:
        return HeatedDebateCommit(None, diff_check.stdout.strip() or "staged debate failed diff check")

    commit = _run_heated_git(
        heated_root,
        "commit",
        "-m",
        f"debate: track {stage.debate_dir.name}",
        "--",
        rel_path,
    )
    if commit.returncode != 0:
        return HeatedDebateCommit(None, commit.stderr.strip() or commit.stdout.strip() or "git commit failed")

    revision = _run_heated_git(heated_root, "rev-parse", "--short", "HEAD")
    if revision.returncode != 0:
        return HeatedDebateCommit(None, revision.stderr.strip() or "could not read debate commit")
    return HeatedDebateCommit(revision.stdout.strip())


