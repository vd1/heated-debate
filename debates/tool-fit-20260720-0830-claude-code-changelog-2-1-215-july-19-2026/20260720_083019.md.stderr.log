+def _build_heated_debate_verification_prompt(
+    stage: HeatedDebateStage,
+    run: HeatedDebateRun,
+) -> str:
+    transcript_path = run.transcript_path
+    artifact_paths = [
+        ("topic.md", stage.topic_path),
+        ("context", stage.context_path),
+        ("transcript", transcript_path),
+    ]
+    sections: list[str] = [
+        "You are verifying a Mopsus heated-debate tool-pilot artefact before it is auto-committed.",
+        "",
+        "Check whether the topic, context, transcript, admissibility gates, and final recommendation are coherent.",
+        "For bug-fix or newly-enabled command candidates, reject if the local condition fixed or enabled is absent or unproven.",
+        "For behaviour-change candidates, verify that the local workflow dependency is evidenced by the project context.",
+        "",
+        "Return concise findings and end with a final line. Use exactly `VERDICT: reject` only when the artefact should not be committed.",
+        "",
+        f"Debate directory: {stage.debate_dir}",
+        "",
+    ]
+    for label, path in artifact_paths:
+        if path is None:
+            continue
+        sections.extend(
+            [
+                f"## {label}",
+                f"Path: {path}",
+                path.read_text(encoding="utf-8", errors="replace"),
+                "",
+            ]
+        )
+    return "\n".join(sections)
+
+
+def _verify_heated_debate_stage(
+    stage: HeatedDebateStage,
+    run: HeatedDebateRun,
+) -> HeatedDebateVerification:
+    command = os.environ.get("TOOL_DIGEST_VERIFY_COMMAND", "").strip() or "claude"
+    prompt = _build_heated_debate_verification_prompt(stage, run)
+    timeout = _int_env("TOOL_DIGEST_VERIFY_TIMEOUT_SECS", 300)
+    cmd = shlex.split(command) + ["-p", "--output-format", "text"]
+    proc = subprocess.run(
+        cmd,
+        input=f"/verify\n\n{prompt}",
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=timeout,
+        check=False,
+    )
+    output_parts = []
+    if proc.stdout:
+        output_parts.append(proc.stdout.rstrip())
+    if proc.stderr:
+        output_parts.append("stderr:\n" + proc.stderr.rstrip())
+    output = "\n\n".join(output_parts).strip()
+    rejected = any(line == "VERDICT: reject" for line in output.splitlines())
+    verification_path = stage.debate_dir / "verification.md"
+    verification_text = (
+        "# Verification\n\n"
+        f"- Command: `{shlex.join(cmd)}` with `/verify` prompt\n"
+        f"- Exit code: `{proc.returncode}`\n"
+        f"- Rejected: `{'true' if rejected else 'false'}`\n\n"
+        "## Output\n\n"
+        f"{output}\n"
+    )
+    verification_path.write_text(verification_text, encoding="utf-8")
+    return HeatedDebateVerification(
+        path=verification_path,
+        output=output,
+        returncode=proc.returncode,
+        rejected=rejected,
+    )
+
+
