+def _init_heated_debate_repo(heated_root: Path) -> None:
+    import subprocess
+
+    heated_root.mkdir()
+    for args in (
+        ("init",),
+        ("config", "user.name", "Mopsus Test"),
+        ("config", "user.email", "mopsus-test@example.test"),
+    ):
+        subprocess.run(["git", *args], cwd=heated_root, check=True, capture_output=True)
+    (heated_root / "README.md").write_text("fixture\n")
