+    subprocess.run(
+        ["git", "commit", "-m", "fixture"],
+        cwd=heated_root,
+        check=True,
+        capture_output=True,
+    )
+
+
+def _stage_fake_debate(heated_root: Path):
+    from mopsus.tool_digest import HeatedDebateRun, HeatedDebateStage
+
+    debate_dir = heated_root / "debates" / "tool-fit"
+    debate_dir.mkdir(parents=True)
+    topic_path = debate_dir / "topic.md"
+    context_path = debate_dir / "context.txt"
+    transcript_path = debate_dir / "20260509_100000.md"
+    topic_path.write_text("topic\n")
+    context_path.write_text("context\n")
+    transcript_path.write_text("finished\n")
+    stage = HeatedDebateStage(
+        debate_dir=debate_dir,
+        topic_path=topic_path,
+        context_path=context_path,
+        command="bun shelley.ts -f debates/tool-fit/topic.md 5",
+        projects=(),
+    )
+    run = HeatedDebateRun(transcript_path, "", "", 0)
+    return stage, run
+
+
+def _write_fake_verifier(tmp_path: Path) -> Path:
+    verifier = tmp_path / "fake_verifier.py"
