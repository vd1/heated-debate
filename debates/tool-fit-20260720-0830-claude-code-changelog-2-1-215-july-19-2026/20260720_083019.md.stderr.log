import asyncio
import os
from datetime import datetime, timedelta
from unittest.mock import AsyncMock, Mock, patch


def _source(key: str, platform: str, kind: str):
    from mopsus.tool_digest import SourceConfig

    return SourceConfig(
        key=key,
        platform=platform,
        name=f"{platform} test source",
        url="https://example.test/source",
        kind=kind,
    )


class _FakeProcess:
    def __init__(self, stdout: bytes = b"", stderr: bytes = b"", returncode: int = 0):
        self._stdout = stdout
        self._stderr = stderr
        self.returncode = returncode
        self.killed = False

    async def communicate(self):
        return self._stdout, self._stderr

    def kill(self):
        self.killed = True


class TestToolDigestExtraction:
    def test_extracts_commands_and_tools_from_reference_text(self):
        from mopsus.tool_digest import SourceSnapshot, extract_items

        snapshot = SourceSnapshot(
            source=_source("claude-tools", "Claude Code", "commands"),
            fetched_url="https://example.test/tools",
            text="""
            <html><body>
            Tool Description Permission Required
            <code>Monitor </code> Runs a command in the background.
            <code>PowerShell </code> Executes PowerShell commands natively.
            <code>/review [PR]</code> Review a pull request locally.
            </body></html>
            """,
        )

        titles = {item.title for item in extract_items([snapshot])}

        assert "Monitor" in titles
