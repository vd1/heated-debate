+        "\n".join(
+            [
+                "import os",
+                "import sys",
+                "",
+                "prompt = sys.stdin.read()",
+                "Path = __import__('pathlib').Path",
+                "Path(os.environ['VERIFY_PROMPT_PATH']).write_text(prompt)",
+                "Path(os.environ['VERIFY_ARGV_PATH']).write_text('\\n'.join(sys.argv[1:]))",
+                "mode = os.environ.get('VERIFY_MODE', 'pass')",
+                "if mode == 'reject':",
+                "    print('Findings')",
+                "    print('VERDICT: reject')",
+                "    raise SystemExit(0)",
+                "if mode == 'nonzero':",
+                "    print('could not verify')",
+                "    raise SystemExit(2)",
