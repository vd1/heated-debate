"""backend.py -- unified async backend protocol for AI agents.

Each backend wraps a CLI tool (Claude, Codex, etc.) behind a common
async interface: run(system_prompt, user_prompt) -> (response, error).
"""

from __future__ import annotations

import asyncio
import json
import os
import tempfile
from dataclasses import dataclass, field
from pathlib import Path
from typing import Protocol

from mopsus.security import (
    add_subprocess_env,
    build_claude_env,
    sanitize_subprocess_arg,
)


REPO_DIR = Path(__file__).resolve().parent.parent
BLACKBOARD_MCP_SERVER = REPO_DIR / "mopsus" / "blackboard_mcp.py"
BLACKBOARD_FILE = REPO_DIR / "mopsus" / "config" / "blackboard.json"


class Backend(Protocol):
    """Protocol for AI agent backends."""
    name: str
    model: str

    async def run(self, system: str, prompt: str) -> tuple[str | None, str | None]:
        """Run a prompt and return (response_text, error_message)."""
        ...


@dataclass
class ClaudeBackend:
    """Claude CLI backend."""
    model: str
    name: str = "claude"
    timeout_secs: int = 300
    claude_bin: str = "claude"

    async def run(self, system: str, prompt: str) -> tuple[str | None, str | None]:
        cmd = [
            self.claude_bin,
            "-p",
            "--model", self.model,
            "--output-format", "text",
            "--append-system-prompt", system,
        ]
        env = build_claude_env()
        try:
            proc = await asyncio.create_subprocess_exec(
                *cmd,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
                env=env,
            )
            stdout, stderr = await asyncio.wait_for(
                proc.communicate(input=prompt.encode()),
                timeout=self.timeout_secs,
            )
        except FileNotFoundError:
            return None, f"claude CLI not found at {self.claude_bin}"
        except asyncio.TimeoutError:
            try:
                proc.kill()
            except ProcessLookupError:
                pass
            return None, f"claude timed out after {self.timeout_secs}s"

        stdout_text = stdout.decode(errors="replace").strip() if stdout else ""
        stderr_text = stderr.decode(errors="replace").strip() if stderr else ""

        if proc.returncode != 0:
            detail = stderr_text or stdout_text or "no details"
            line = " ".join(detail.splitlines()[-1].split())
            return None, f"claude exited {proc.returncode}: {line}"

        if not stdout_text:
            return None, "claude returned empty output"
        return stdout_text, None


def _build_codex_env() -> dict[str, str]:
    """Build sanitized environment for Codex subprocess."""
    env = build_claude_env()
    for key, value in os.environ.items():
        if key.startswith(("CODEX_", "OPENAI_")):
            add_subprocess_env(env, key, value)
    return env


def _env_true(name: str) -> bool:
    return os.environ.get(name, "").strip().lower() in {"1", "true", "yes", "on"}


def _toml_string(value: str) -> str:
    return json.dumps(value)


def _toml_array(values: list[str]) -> str:
    return "[" + ",".join(_toml_string(value) for value in values) + "]"


def blackboard_mcp_enabled() -> bool:
    return _env_true("MOPSUS_BLACKBOARD_MCP")


def blackboard_mcp_config_overrides(chat_id: int | None = None) -> list[str]:
    """Return per-run Codex config overrides for the blackboard MCP server."""
    env_args = [
        "MOPSUS_BLACKBOARD_MCP=true",
        f"MOPSUS_BLACKBOARD_PATH={BLACKBOARD_FILE}",
    ]
    if chat_id is not None:
        env_args.append(f"MOPSUS_BLACKBOARD_CHAT_ID={chat_id}")
    env_args.extend(["python3", str(BLACKBOARD_MCP_SERVER)])
    return [
        'mcp_servers.mopsus_blackboard.command="/usr/bin/env"',
        f"mcp_servers.mopsus_blackboard.args={_toml_array(env_args)}",
    ]


