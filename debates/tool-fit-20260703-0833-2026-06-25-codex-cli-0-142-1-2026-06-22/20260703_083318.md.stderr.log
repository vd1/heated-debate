#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 3 ]; then
  cat <<'USAGE' >&2
Usage:
  run_claude_call_auto.sh <model> <creativity_level> <prompt_file> [purpose] [timeout_seconds]
USAGE
  exit 2
fi

MODEL="$1"
CREATIVITY="$2"
PROMPT_FILE="$3"
PURPOSE="${4:-generic}"
TIMEOUT_SECONDS="${5:-180}"

if [ ! -f "$PROMPT_FILE" ]; then
  echo "Prompt file not found: $PROMPT_FILE" >&2
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNER="$SCRIPT_DIR/run_claude_call.sh"
ROOT="${ROOT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
LOG_FILE="$ROOT/doc/logs/claude_call_log.md"
OUT_DIR="$ROOT/doc/logs/claude_outputs"

if [ ! -x "$RUNNER" ]; then
  echo "Runner not executable: $RUNNER" >&2
  exit 2
fi

mkdir -p "$OUT_DIR"

next_call_id() {
  local max_id=0
  local candidate
  local n

  if [ -d "$OUT_DIR" ]; then
    while IFS= read -r candidate; do
      n="$(basename "$candidate" | sed -E 's/^claude-([0-9]+)\.txt$/\1/')"
      if [[ "$n" =~ ^[0-9]+$ ]] && [ "$((10#$n))" -gt "$((10#$max_id))" ]; then
        max_id="$((10#$n))"
      fi
    done < <(find "$OUT_DIR" -maxdepth 1 -type f -name 'claude-[0-9]*.txt' 2>/dev/null || true)
  fi

  if [ -f "$LOG_FILE" ]; then
    while IFS= read -r candidate; do
      n="${candidate#claude-}"
      if [[ "$n" =~ ^[0-9]+$ ]] && [ "$((10#$n))" -gt "$((10#$max_id))" ]; then
        max_id="$((10#$n))"
      fi
    done < <(grep -oE 'claude-[0-9]+' "$LOG_FILE" || true)
  fi

  printf "claude-%03d\n" "$((max_id + 1))"
}

LAST_RC=0
LAST_TIMED_OUT=0

run_once() {
  local call_id="$1"
  local prompt_file="$2"
  local purpose="$3"
  local timeout_seconds="$4"
  local marker
  local pid
  local watchdog

  marker="$(mktemp)"
  rm -f "$marker"

  "$RUNNER" "$call_id" "$MODEL" "$CREATIVITY" "$prompt_file" "$purpose" &
  pid="$!"

  (
    sleep "$timeout_seconds"
    if kill -0 "$pid" 2>/dev/null; then
      echo "timeout" > "$marker"
      kill -TERM "$pid" 2>/dev/null || true
      sleep 2
      kill -KILL "$pid" 2>/dev/null || true
    fi
  ) &
  watchdog="$!"

  set +e
  wait "$pid"
  LAST_RC="$?"
  set -e

  kill "$watchdog" 2>/dev/null || true
  wait "$watchdog" 2>/dev/null || true

  LAST_TIMED_OUT=0
  if [ -f "$marker" ]; then
    LAST_TIMED_OUT=1
  fi
  rm -f "$marker"
}

FIRST_CALL_ID="$(next_call_id)"
run_once "$FIRST_CALL_ID" "$PROMPT_FILE" "$PURPOSE" "$TIMEOUT_SECONDS"

if [ "$LAST_RC" -eq 0 ] && [ "$LAST_TIMED_OUT" -eq 0 ]; then
  echo "completed: $FIRST_CALL_ID"
  echo "output: doc/logs/claude_outputs/${FIRST_CALL_ID}.txt"
  exit 0
fi

RETRY_PROMPT="$(mktemp)"
cat > "$RETRY_PROMPT" <<EOF
Retry mode after failed/empty/timed-out prior call.
Respond concisely and follow the requested output format exactly.

$(cat "$PROMPT_FILE")
EOF

SECOND_CALL_ID="$(next_call_id)"
run_once "$SECOND_CALL_ID" "$RETRY_PROMPT" "$PURPOSE [auto-retry]" "$TIMEOUT_SECONDS"
rm -f "$RETRY_PROMPT"

if [ "$LAST_RC" -eq 0 ] && [ "$LAST_TIMED_OUT" -eq 0 ]; then
  echo "completed after retry: $SECOND_CALL_ID"
  echo "output: doc/logs/claude_outputs/${SECOND_CALL_ID}.txt"
  exit 0
fi

echo "failed after one retry."
echo "first call:  $FIRST_CALL_ID"
echo "retry call:  $SECOND_CALL_ID"
echo "check: doc/logs/claude_call_log.md"
exit 1
#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 4 ]; then
  cat <<'USAGE' >&2
Usage:
  run_claude_call.sh <call_id> <model> <creativity_level> <prompt_file> [purpose]
USAGE
  exit 2
fi

CALL_ID="$1"
MODEL="$2"
CREATIVITY="$3"
PROMPT_FILE="$4"
PURPOSE="${5:-generic}"

if ! command -v claude >/dev/null 2>&1; then
  echo "claude CLI not found in PATH." >&2
  exit 127
fi

if [ ! -f "$PROMPT_FILE" ]; then
  echo "Prompt file not found: $PROMPT_FILE" >&2
  exit 2
fi

ROOT="${ROOT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
LOG_DIR="$ROOT/doc/logs"
OUT_DIR="$LOG_DIR/claude_outputs"
LOG_FILE="$LOG_DIR/claude_call_log.md"
OUT_FILE="$OUT_DIR/${CALL_ID}.txt"

mkdir -p "$OUT_DIR"
if [ -f "$OUT_FILE" ]; then
  echo "Output file already exists for call id '$CALL_ID': $OUT_FILE" >&2
  echo "Use a new call id to avoid duplicate log/output rows." >&2
  exit 2
fi

if [ ! -f "$LOG_FILE" ]; then
  cat > "$LOG_FILE" <<'HEADER'
# Claude Call Log

## Productive Calls (Decision-Relevant)

| Call ID | UTC Timestamp | Creativity | Purpose | Status | Output |
|---|---|---:|---|---|---|
HEADER
fi

if grep -Fq "| \`$CALL_ID\` |" "$LOG_FILE"; then
  echo "Call id '$CALL_ID' already exists in $LOG_FILE" >&2
  echo "Use a new call id to keep one terminal log entry per call." >&2
  exit 2
fi

TS="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
STATUS="completed"
LOGGED=0

append_log() {
  if [ "$LOGGED" -eq 1 ]; then
    return
  fi
  echo "| \`$CALL_ID\` | $TS | $CREATIVITY | $PURPOSE | $STATUS | \`doc/logs/claude_outputs/${CALL_ID}.txt\` |" >> "$LOG_FILE"
  LOGGED=1
}

on_interrupt() {
  STATUS="cancelled"
  TS="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  append_log || true
  exit 130
}

trap on_interrupt INT TERM

set +e
cat "$PROMPT_FILE" | claude -p --model "$MODEL" --output-format text | tee "$OUT_FILE"
PIPE_RC=("${PIPESTATUS[@]}")
CLAUDE_RC="${PIPE_RC[0]:-1}"
TEE_RC="${PIPE_RC[1]:-1}"
set -e

if [ "$TEE_RC" -ne 0 ]; then
  STATUS="failed"
elif [ "$CLAUDE_RC" -ne 0 ]; then
  if [ "$CLAUDE_RC" -eq 130 ]; then
    STATUS="cancelled"
  else
    STATUS="failed"
  fi
elif [ ! -s "$OUT_FILE" ]; then
  STATUS="cancelled"
fi

TS="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
append_log

if [ "$STATUS" != "completed" ]; then
  exit 1
fi

